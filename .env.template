# Optional: override which vault address Kalani APR oracle reads (defaults to Creative Bank vault)
KALANI_VAULT_ADDRESS=

# Vault address the UI should treat as "Creative Bank" Yearn V3 vault (ERC-4626)
NEXT_PUBLIC_CREATIVE_BANK_YEARN_VAULT_ADDRESS=

# Canonical app URL — used for WalletConnect metadata and other origin-bound configs.
# Prod: https://finance.creativeplatform.xyz
NEXT_PUBLIC_APP_URL=

# Privy (authentication + embedded wallets)
# Create an app at https://dashboard.privy.io — enable Email + Google login methods.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Alchemy (RPC + wallet activity indexing)
# Server-side key powers /api/rpc/* proxies and getWalletActivity; client key is optional fallback.
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=

NEXT_PUBLIC_CHAIN_ID=base

# Blockchain
NEXT_PUBLIC_USDC_MINT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# WalletConnect (optional external wallet connector)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Twilio SMS (required in production for Coinbase phone verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Coinbase onramp/offramp
NEXT_PUBLIC_COINBASE_APP_ID=
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=

# CockroachDB Serverless (GCP us-east1 — transaction ledger)
# Copy General Connection String from Cockroach Cloud (user + creative-finance DB):
# postgresql://gawain:<PASSWORD>@<cluster-host>.cockroachlabs.cloud:26257/creative-finance?sslmode=verify-full
COCKROACHDB_URL=

# Webhooks
GOLDSKY_WEBHOOK_SECRET=

# Vercel Cron authentication
CRON_SECRET=

# Wert (alternative onramp)
NEXT_PUBLIC_WERT_PARTNER_ID=
WERT_API_KEY=
WERT_PRIVATE_KEY=
