# Optional: override which vault address Kalani APR oracle reads (defaults to Creative Bank vault)
KALANI_VAULT_ADDRESS=

# Vault address the UI should treat as "Creative Bank" Yearn V3 vault (ERC-4626)
NEXT_PUBLIC_CREATIVE_BANK_YEARN_VAULT_ADDRESS=

# Canonical app URL — used for WalletConnect metadata and other origin-bound configs.
# Prod: https://finance.creativeplatform.xyz
NEXT_PUBLIC_APP_URL=

# Privy (authentication + embedded wallets)
# Create an app at https://dashboard.privy.io — enable Email + Google login methods.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Required in production when HttpOnly cookies use a custom Privy subdomain
# (Dashboard → App settings → Domains). Example:
# NEXT_PUBLIC_PRIVY_API_URL=https://privy.finance.creativeplatform.xyz
NEXT_PUBLIC_PRIVY_API_URL=

# Privy Earn vault ID from Wallet infrastructure > Earn (not a secret).
NEXT_PUBLIC_PRIVY_EARN_VAULT_ID=wawi07rarv7tntzfepl0sks4

# Alchemy (RPC + wallet activity indexing)
# Server-side key powers /api/rpc/* proxies and getWalletActivity; client key is optional fallback.
# Robinhood Chain: when the Alchemy app includes Robinhood, Node API + Websockets work at
# robinhood-mainnet.g.alchemy.com (HTTP) / wss://robinhood-mainnet.g.alchemy.com (WS).
# Also available on Robinhood (future): NFT, Token, Prices, Transfers, Bundler, Gas Manager, Webhooks.
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=

# 0x Swap API — required for /trade Stock Token RFQ quotes on Robinhood Chain
# Create a key at https://dashboard.0x.org
ZERO_EX_API_KEY=

NEXT_PUBLIC_CHAIN_ID=base

# Blockchain
NEXT_PUBLIC_USDC_MINT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# WalletConnect (optional external wallet connector)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Twilio SMS (required in production for Coinbase phone verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Coinbase onramp/offramp
